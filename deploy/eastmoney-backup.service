[Unit]
Description=Eastmoney SQLite backup

[Service]
Type=oneshot
User=eastmoney
Group=eastmoney
WorkingDirectory=/opt/eastmoney
EnvironmentFile=/etc/eastmoney/eastmoney.env
ExecStart=/opt/eastmoney/venv/bin/python -m app.backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eastmoney/data
